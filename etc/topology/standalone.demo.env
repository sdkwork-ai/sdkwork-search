# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_search_demo` and a
# dedicated Redis prefix `search-demo` on a distinct logical DB index so no cache key (session,
# rate-limit, search/index idempotency) collides with another env sharing the deployment Redis.
SDKWORK_SEARCH_DEPLOYMENT_PROFILE=standalone
SDKWORK_SEARCH_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_SEARCH_PROFILE_ID=standalone.demo
SDKWORK_SEARCH_APPLICATION_PUBLIC_HTTP_URL=https://search-demo.sdkwork.com
SDKWORK_SEARCH_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3900


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SEARCH_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://search-demo.sdkwork.com,http://search-demo.sdkwork.com,https://search-demo.birdcoder.com,http://search-demo.birdcoder.com,https://search-demo.dtupay.com,http://search-demo.dtupay.com,https://search-demo.noaper.com,http://search-demo.noaper.com,https://search-demo.sdkwork.cn,http://search-demo.sdkwork.cn,https://search-demo.birdcoder.cn,http://search-demo.birdcoder.cn,https://search-demo.dtupay.cn,http://search-demo.dtupay.cn,https://search-demo.noaper.cn,http://search-demo.noaper.cn,https://search-demo.skubc.com,http://search-demo.skubc.com,https://search-demo.skubc.cn,http://search-demo.skubc.cn,https://search-demo.zowalk.com,http://search-demo.zowalk.com,https://search-demo.zowalk.cn,http://search-demo.zowalk.cn,https://search-demo.offer86.com,http://search-demo.offer86.com,https://search-demo.offer86.cn,http://search-demo.offer86.cn,https://search-demo.86offer.com,http://search-demo.86offer.com,https://search-demo.86offer.cn,http://search-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
