# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_SEARCH_DEPLOYMENT_PROFILE=cloud
SDKWORK_SEARCH_ENVIRONMENT=staging
SDKWORK_SEARCH_PROFILE_ID=cloud.staging
SDKWORK_SEARCH_APPLICATION_PUBLIC_HTTP_URL=https://search-staging.sdkwork.com
SDKWORK_SEARCH_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SEARCH_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

