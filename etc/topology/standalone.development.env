# Bootstrap profile standalone.development — replace with application-specific values.
SDKWORK_SEARCH_DEPLOYMENT_PROFILE=standalone
SDKWORK_SEARCH_ENVIRONMENT=development
SDKWORK_SEARCH_PROFILE_ID=standalone.development
SDKWORK_SEARCH_APPLICATION_PUBLIC_HTTP_URL=https://search-dev.sdkwork.com
